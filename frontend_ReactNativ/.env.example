# Default backend URL — set this to the IP/hostname of the machine running the backend.
# This is embedded at build time by Expo. Change it before running `npx expo start` or building.
EXPO_PUBLIC_SERVER_URL=http://[Server IP]:8000

# Polling / refresh intervals (milliseconds). Defaults used if not set.
# EXPO_PUBLIC_CONNECTIVITY_POLL_INTERVAL=10000
# EXPO_PUBLIC_EPISODES_REFRESH_INTERVAL=15000
# EXPO_PUBLIC_READ_ONLY_CHECK_INTERVAL=8000
# EXPO_PUBLIC_CONNECTION_TEST_TIMEOUT=5000

# EXPO_PUBLIC_PAGE_SIZE=20
